{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "arnifi-creative-studio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    "FIRESTORE_PROJECT_ID": "demo-arnifi-studio",
    "STORAGE_BUCKET": "arnifi-studio",
    "STORAGE_REGION": "auto",
    "STORAGE_ENDPOINT": "",
    "STORAGE_PUBLIC_ENDPOINT": "",
    "OPENAI_OAUTH_AUTHORIZE_URL": "",
    "OPENAI_OAUTH_TOKEN_URL": "",
    "OPENAI_OAUTH_CLIENT_ID": ""
  },
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "COMPANION_LIMITER", "namespace_id": "1002", "simple": { "limit": 240, "period": 60 } }
  ]
  // Secrets (wrangler secret put): GOOGLE_SA_EMAIL, GOOGLE_SA_KEY, STORAGE_ACCESS_KEY_ID,
  // STORAGE_SECRET_ACCESS_KEY, TOKEN_KEY. Local values live in .dev.vars (git-ignored).
}
