rules_version = '2';
// No client access at all. The app has no end-user auth (Cloudflare Access gates the URL), so the
// only readers and writers are the Cloudflare Worker (service account over REST) and the Cloud
// Functions (Admin SDK), both of which bypass these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
