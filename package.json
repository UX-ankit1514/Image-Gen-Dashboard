{
  "name": "arnifi-creative-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/functions",
    "apps/companion",
    "tools/*"
  ],
  "scripts": {
    "dev": "node tools/dev/dev.mjs",
    "dev:web": "npm run dev -w @acs/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @acs/web && npm run typecheck -w @acs/functions",
    "test": "vitest run",
    "test:py": "cd python && venv/bin/python -m unittest discover -s tests -v",
    "parity": "npm run parity -w @acs/parity",
    "seed": "tsx tools/dev/seed.ts",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "build:functions": "npm run build -w @acs/functions",
    "build:web": "npm run build -w @acs/web",
    "companion": "tsx apps/companion/src/cli.ts",
    "deploy:firebase": "npm run build:functions && firebase deploy --only firestore:rules,firestore:indexes,functions",
    "deploy:web": "npm run deploy -w @acs/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.3",
    "aws4fetch": "1.0.20",
    "concurrently": "10.0.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
